# SeaLink Mobile App Environment Variables
# In Expo, any variable accessible in React Native code MUST start with EXPO_PUBLIC_

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_key_here

# Default ESP32 Gateway IP (over SoftAP Wi-Fi)
EXPO_PUBLIC_GATEWAY_URL=http://192.168.4.1
